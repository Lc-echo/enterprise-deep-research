# ========================================================
# Enterprise Deep Research Agent - Environment Configuration Example
# 复制本文件为 .env 并填入真实凭据；.env 已被 .gitignore 忽略，不会提交
# ========================================================

# 大模型 API 配置（支持通义千问、DeepSeek、OpenAI、Kimi 等 OpenAI 兼容端点）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tavily AI 搜索 API Key（留空则降级为 DuckDuckGo；所有搜索通道均失败时不会伪造信源，报告将标注为降级模式）
TAVILY_API_KEY=

# 分层模型选型（留空则使用代码内默认值）
SUPERVISOR_MODEL=qwen-plus
WORKER_MODEL=qwen-plus
SYNTHESIZER_MODEL=qwen-max

# 研究控制参数
MAX_RESEARCH_LOOPS=2
MAX_SECTIONS_PER_REPORT=4
SEARCH_RESULTS_PER_QUERY=4

# 服务端口
API_PORT=8000

# 工具层传输：stdio（默认，独立 MCP 子进程）/ direct（进程内调用，仅供调试）
MCP_TRANSPORT=stdio

# CORS 允许来源（逗号分隔），默认仅本机
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://localhost:3000
